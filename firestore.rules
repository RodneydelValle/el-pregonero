rules_version = '2';
// Reglas de Firestore para IMP TRAVEL y el Visor de Perfil.
// Se pegan en la consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== IMP TRAVEL: cada persona solo puede leer y escribir SUS favoritos =====
    match /favoritos/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Solo listas de id cortos (letras, números, "-" y "_"): nada de datos arbitrarios ni textos gigantes.
      // Si algún elemento no es texto, join() falla y la escritura se rechaza.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['eventos', 'restaurantes', 'actualizado'])
        && request.resource.data.eventos is list && request.resource.data.eventos.size() <= 500
        && request.resource.data.restaurantes is list && request.resource.data.restaurantes.size() <= 300
        && request.resource.data.eventos.join(',').matches('^([A-Za-z0-9_-]{1,64}(,[A-Za-z0-9_-]{1,64})*)?$')
        && request.resource.data.restaurantes.join(',').matches('^([A-Za-z0-9_-]{1,64}(,[A-Za-z0-9_-]{1,64})*)?$')
        && request.resource.data.actualizado == request.time;
    }

    // ===== Visor de Perfil (maqueta de Instagram) =====
    // Perfiles PÚBLICOS (visor_equipo; visor_pruebas = pruebas automáticas): acceso abierto a propósito
    // (lo decidió el dueño): cualquiera con el visor puede ver y editar. Solo se limita la forma y el tamaño.
    // Perfiles OCULTOS (visor_oculto; visor_pruebas_oculto = pruebas): solo el administrador (por su uid)
    // los crea, borra y elige quién los ve (lista «lectores» de correos). Las personas de esa lista, con sesión
    // iniciada y correo verificado, los ven y editan, pero no pueden cambiar la lista.
    function esAdminVisor() { return request.auth != null && request.auth.uid == 'mu9z2GNHceR3xoNxK2oK4DLToVk1'; }
    function esLector(lectores) {
      return request.auth != null && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').lower() in lectores;
    }
    function esPublica(c) { return c in ['visor_equipo', 'visor_pruebas']; }
    function esOculta(c) { return c in ['visor_oculto', 'visor_pruebas_oculto']; }
    // resource.data.lectores directo (todo perfil oculto lo trae): así Firestore puede comprobar la consulta array-contains
    function puedeVer(d) { return esAdminVisor() || esLector(d.lectores); }
    function puedeVerPerfil(c, sid) {
      return esAdminVisor() || esLector(get(/databases/$(database)/documents/$(c)/$(sid)).data.get('lectores', []));
    }
    function texto(v, max) { return v is string && v.size() <= max; }
    function imagen(v) {
      return v is string && (v == ''
        || v.matches('^https://res[.]cloudinary[.]com/[a-z0-9_-]{1,60}/image/upload/[A-Za-z0-9._~/%,:-]{1,400}$'));
    }
    function perfilValido(p) {
      return p is map
        && p.keys().hasOnly(['usuario', 'nombre', 'avatar', 'aro', 'verif', 'pubs', 'seguidores', 'seguidos', 'cat', 'bio', 'enlace', 'botones', 'azul'])
        && texto(p.get('usuario', ''), 60) && texto(p.get('nombre', ''), 80) && imagen(p.get('avatar', ''))
        && p.get('aro', true) is bool && p.get('verif', false) is bool && p.get('azul', true) is bool
        && texto(p.get('pubs', ''), 20) && texto(p.get('seguidores', ''), 20) && texto(p.get('seguidos', ''), 20)
        && texto(p.get('cat', ''), 60) && texto(p.get('bio', ''), 500)
        && texto(p.get('enlace', ''), 120) && texto(p.get('botones', ''), 120);
    }
    // hasta 50 correos en minúsculas; si algún elemento no es texto, join() falla y se rechaza
    function lectoresValidos(l) {
      return l is list && l.size() <= 50 && l.join(',').size() <= 6000
        && l.join(',').matches('^([^,@ A-Z]{1,64}@[^,@ A-Z]{1,100}(,[^,@ A-Z]{1,64}@[^,@ A-Z]{1,100})*)?$');
    }
    function metaValida(d, oculto) {
      return d.keys().hasOnly(['nombre', 'perfil', 'destacadas', 'creado', 'lectores'])
        && texto(d.nombre, 80) && perfilValido(d.perfil)
        && d.destacadas is list && d.destacadas.size() <= 30
        && d.creado is number
        && ((!oculto && !('lectores' in d)) || (oculto && lectoresValidos(d.get('lectores', null))));
    }
    function postValido(d) {
      return d.keys().hasOnly(['img', 'desc', 'tipo', 'propuesta', 'fijado', 'o', 'creado'])
        && imagen(d.img) && d.img != ''
        && texto(d.desc, 2200)
        && d.tipo in ['foto', 'carrusel', 'reel']
        && d.propuesta is bool && d.fijado is bool
        && d.o is number && d.creado is number;
    }
    match /{coleccion}/{sid} {
      allow read: if esPublica(coleccion) || (esOculta(coleccion) && puedeVer(resource.data));
      allow delete: if esPublica(coleccion) || (esOculta(coleccion) && esAdminVisor());
      allow create: if sid.matches('^[A-Za-z0-9]{4,40}$')
        && ((esPublica(coleccion) && metaValida(request.resource.data, false))
          || (esOculta(coleccion) && esAdminVisor() && metaValida(request.resource.data, true)));
      allow update: if sid.matches('^[A-Za-z0-9]{4,40}$')
        && ((esPublica(coleccion) && metaValida(request.resource.data, false))
          || (esOculta(coleccion) && metaValida(request.resource.data, true)
            && (esAdminVisor()
              || (esLector(resource.data.get('lectores', [])) && request.resource.data.lectores == resource.data.lectores))));
      match /posts/{pid} {
        allow read, delete: if esPublica(coleccion) || (esOculta(coleccion) && puedeVerPerfil(coleccion, sid));
        allow create, update: if pid.matches('^[A-Za-z0-9]{4,40}$') && postValido(request.resource.data)
          && (esPublica(coleccion) || (esOculta(coleccion) && puedeVerPerfil(coleccion, sid)));
      }
    }

    // Todo lo demás queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
